# ==============================================================================
# Red Mercury - Production Frontend Container
# Multi-stage build for React SPA served via hardened, unprivileged Nginx
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Static Assets
# ------------------------------------------------------------------------------
FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Hardened Nginx Web Server
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine-slim@sha256:b947b2630c97622793113555e13332eec85bdc7a0ac6ab697159af78942bb856 AS runtime

LABEL maintainer="Xerova Digital Solutions <security@xerova.com>"
LABEL service="redmercury-frontend"

# Copy compiled static assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy production Nginx virtual host configuration
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Remove Cloudflare deployment metadata from Nginx static webroot & set unprivileged ownership
RUN rm -f /usr/share/nginx/html/_headers /usr/share/nginx/html/wrangler.json && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx && \
    chmod -R a+rX /usr/share/nginx/html

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
