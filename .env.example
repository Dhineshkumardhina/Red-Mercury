# ==============================================================================
# Red Mercury - Environment Configuration Template
# xerova Digital Solutions
# 
# SECURITY NOTICE:
# - Do NOT commit real secrets or production API keys to source control.
# - Copy this file to '.env' for local development:
#     PowerShell: Copy-Item .env.example .env
# ==============================================================================

# --- Application Core ---
APP_NAME="Red Mercury"
APP_VERSION="0.1.0"
APP_ENV="development" # development | staging | production
DEBUG=true
ORGANIZATION="Xerova Digital Solutions"

# --- Backend Host & Network ---
HOST="0.0.0.0"
PORT=8001
API_V1_PREFIX="/api/v1"

# --- Database Configuration ---
# Development: Local SQLite database
DATABASE_URL="sqlite:///./redmercury.db"
# Production Example (PostgreSQL):
# DATABASE_URL="postgresql+psycopg://redmercury_user:CHANGE_ME_PASSWORD@db-host:5432/redmercury_prod"

# --- CORS Allowed Origins (Comma-separated or JSON list) ---
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# --- Logging & Telemetry ---
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT_JSON=false # Set to true for JSON structured logging in production / ELK / Datadog

# --- Security & Cryptography ---
# Generate a cryptographically strong 32+ character key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="dev-insecure-secret-key-replace-in-production!!"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SAMESITE="lax" # Use "none" (with HTTPS/Secure) for cross-site frontend/API deployments
COOKIE_DOMAIN=""

# --- Distributed Rate Limiting (Redis) ---
# Set REDIS_URL in multi-instance staging/production deployments
REDIS_URL=""
RATE_LIMIT_FAIL_OPEN=true # Set false in strict production deployments to fail closed on Redis outage

# --- Repository Ingestion Hardening ---
# Local filesystem ingestion is strictly disabled in production by default.
# To opt in, set ALLOW_LOCAL_INGESTION_IN_PRODUCTION=true AND provide explicit allowlisted roots.
ALLOW_LOCAL_INGESTION_IN_PRODUCTION=false
LOCAL_INGESTION_ALLOWED_ROOTS=""
MAX_NESTED_ARCHIVES=5
# Mandatory in production/staging to enable public Git ingestion (fail-closed SSRF egress policy)
GIT_EGRESS_PROXY_URL=""
ALLOW_PRIVATE_GIT_EGRESS_PROXY=false
APPROVED_GIT_EGRESS_PROXY_HOSTS="egress-proxy,smokescreen"
GITLEAKS_VERSION="8.18.2"
GITLEAKS_LINUX_X64_SHA256="6298c9235dfc9278c14b28afd9b7fa4e6f4a289cb1974bd27949fc1e9122bdee"

# --- Durable Job Execution, Worker Lease, Heartbeat & Retry (Phase 6) ---
JOB_DISPATCH_MODE="auto" # Set "queue_only" in multi-container API/worker deployments
JOB_QUEUE_NAME="redmercury:jobs:queue"
JOB_LEASE_DURATION_SECONDS=60
JOB_HEARTBEAT_INTERVAL_SECONDS=15
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY_SECONDS=2.0
JOB_RETRY_MAX_DELAY_SECONDS=60.0
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2.0

# --- Optional AI Analyzer Key ---
# For server-side LLM triage enhancements (leave blank to run in deterministic synthetic mode)
# GEMINI_API_KEY=""
