# ==============================================================================
# Red Mercury - Sandboxed Security Scanner & Verification Worker
# Dedicated container for executing AST, SAST, secret detection, and test jobs
# ==============================================================================

FROM python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39

LABEL maintainer="Xerova Digital Solutions <security@xerova.com>"
LABEL service="redmercury-worker"
LABEL description="Isolated Sandboxed Worker for Untrusted Repository Security Scans"

WORKDIR /sandbox

# Install essential execution tools and pinned security scanner binaries
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy backend requirements and install dependencies
COPY backend/requirements.txt /sandbox/requirements.txt
RUN pip install --no-cache-dir -r /sandbox/requirements.txt && \
    pip install --no-cache-dir pytest==8.1.1

# Download, cryptographically verify SHA-256 checksum, and install pinned Gitleaks binary (SEC-20)
ARG TARGETARCH
ARG GITLEAKS_VERSION=8.18.2
ARG GITLEAKS_SHA256_AMD64=6298c9235dfc9278c14b28afd9b7fa4e6f4a289cb1974bd27949fc1e9122bdee
ARG GITLEAKS_SHA256_ARM64=4df25683f95b9e1dbb8cc71dac74d10067b8aba221e7f991e01cafa05bcbd030
RUN ARCH="${TARGETARCH:-amd64}" && \
    case "${ARCH}" in \
      amd64) GL_ARCH="x64"; GL_SHA="${GITLEAKS_SHA256_AMD64}" ;; \
      arm64) GL_ARCH="arm64"; GL_SHA="${GITLEAKS_SHA256_ARM64}" ;; \
      *) echo "Unsupported target architecture: ${ARCH}" && exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GL_ARCH}.tar.gz" -o gitleaks.tar.gz && \
    echo "${GL_SHA}  gitleaks.tar.gz" | sha256sum -c - && \
    tar -xzf gitleaks.tar.gz gitleaks && \
    mv gitleaks /usr/local/bin/gitleaks && \
    chmod 755 /usr/local/bin/gitleaks && \
    rm -f gitleaks.tar.gz

# Create dedicated sandboxed unprivileged user
RUN groupadd -g 10002 redmercury-sandbox && \
    useradd -u 10002 -g redmercury-sandbox -s /bin/false -d /sandbox redmercury-sandbox && \
    mkdir -p /sandbox/workspaces /sandbox/temp && \
    chown -R redmercury-sandbox:redmercury-sandbox /sandbox

# Copy backend application codebase for worker processing
COPY backend/app /sandbox/app
COPY backend/alembic /sandbox/alembic
COPY backend/alembic.ini /sandbox/alembic.ini

# Drop privileges to sandbox user
USER redmercury-sandbox:redmercury-sandbox

# Security isolation environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/sandbox \
    PIP_NO_INDEX=1 \
    NO_PROXY="*" \
    WORKSPACE_ROOT=/sandbox/workspaces \
    WORKER_TEMP_DIR=/sandbox/temp

# Container healthcheck using worker self-check
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -m app.scanner.worker --healthcheck || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]

# Worker command: persistent background task consumer
CMD ["python", "-m", "app.scanner.worker"]
