# ==============================================================================
# Red Mercury - Production API Container
# Multi-stage, minimal, hardened, unprivileged container for FastAPI backend
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Dependencies
# ------------------------------------------------------------------------------
FROM python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39 AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt
RUN pip install --no-cache-dir --prefix=/install gunicorn uvicorn[standard] psycopg[binary]

# ------------------------------------------------------------------------------
# Stage 2: Hardened Runtime
# ------------------------------------------------------------------------------
FROM python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39 AS runtime

LABEL maintainer="Xerova Digital Solutions <security@xerova.com>"
LABEL service="redmercury-api"
LABEL description="Red Mercury Production Application Server"

WORKDIR /app

# Install runtime dependencies and security init
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini \
    curl \
    git \
    libpq5 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged system user and group
RUN groupadd -g 10001 redmercury && \
    useradd -u 10001 -g redmercury -s /bin/false -M redmercury

# Copy installed python dependencies from builder
COPY --from=builder /install /usr/local

# Copy backend application code (owned by root, read-only to redmercury runtime user)
COPY backend/app /app/app
COPY backend/alembic /app/alembic
COPY backend/alembic.ini /app/alembic.ini

# Create workspace directory with restricted permissions (only workspaces dir is writable)
RUN mkdir -p /app/data/workspaces && \
    chown -R redmercury:redmercury /app/data && \
    chmod -R 750 /app/data

# Switch to non-root user
USER redmercury:redmercury

# Production environment defaults
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=production \
    HOST=0.0.0.0 \
    PORT=8000

EXPOSE 8000

# Health check using lightweight liveness probe (respects Railway dynamic $PORT)
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD sh -c 'curl -f http://127.0.0.1:${PORT:-8000}/live || exit 1'

ENTRYPOINT ["/usr/bin/tini", "--"]

# Run Alembic migrations then start production ASGI server on $PORT
CMD ["sh", "-c", "alembic upgrade head && exec gunicorn app.main:app --workers ${WEB_CONCURRENCY:-2} --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:${PORT:-8000} --timeout 120 --keep-alive 5 --access-logfile - --error-logfile -"]
